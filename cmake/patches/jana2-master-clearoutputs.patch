+void JArrow::ClearOutputs(OutputData& outputs, size_t output_count) {
+    // Runs the expensive part of event recycling - JEvent::Clear(), whose
+    // JFactorySet::Clear deletes every inserted object (thousands of
+    // deallocations for large raw events) and calls JEventSource::DoFinishEvent
+    // (which synchronizes itself). Must be called WITHOUT the JExecutionEngine
+    // mutex held, after Fire() and before Push(), while the outputs are still
+    // exclusively owned by the worker that fired them.
+    for (size_t output = 0; output < output_count; ++output) {
+        JEvent* event = outputs[output].first;
+        int port_index = outputs[output].second;
+        Port& port = GetPort(port_index);
+        if (port.GetQueue() == nullptr && port.GetPool() != nullptr) {
+            event->Clear(!port.GetSkipFinishEvent());
+        }
+    }
+}
